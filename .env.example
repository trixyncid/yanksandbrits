# Canonical host, e.g. https://staging.example.com. Empty keeps robots on disallow.
NEXT_PUBLIC_SITE_URL=
# true on staging and previews: keeps search engines out even with a domain set.
NEXT_PUBLIC_NOINDEX=

# Identity. The company name defaults to "Yanks and Brits"; an empty tagline is left out of the footer.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_TAGLINE=
# Used in search-engine data only.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE=

# WhatsApp digits only, no plus. Empty hides wa.me links.
NEXT_PUBLIC_WA_NUMBER=

# Full profile URLs, e.g. https://www.instagram.com/yanksandbrits. Empty hides that icon in the footer.
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_YOUTUBE=
NEXT_PUBLIC_FACEBOOK=

# Leads are saved in the database and listed in the CMS under Leads (see docs/leads.md).
# Optional: also POST each new lead as JSON, e.g. to a Slack or email automation.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Optional salt for hashing visitor IPs (rate limiting). Falls back to BETTER_AUTH_SECRET.
LEAD_IP_SALT=

# WhatsApp alerts to counsellors when leads are assigned, via a self-hosted GOWA gateway.
# Empty means no automatic alerts (the CMS offers a send-it-yourself link). See docs/whatsapp-gateway.md.
WA_GATEWAY_URL=
WA_GATEWAY_USERNAME=
WA_GATEWAY_PASSWORD=
# Only when the gateway has more than one linked number.
WA_GATEWAY_DEVICE_ID=

# GA4. The script loads only after analytics consent.
NEXT_PUBLIC_GA_ID=

# Optional Cloudflare Turnstile. Both keys are required before the widget is added.
TURNSTILE_SECRET_KEY=

# CMS database (PostgreSQL). Used by Prisma and Better Auth.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms?schema=public

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app, e.g. http://localhost:3000 locally.
BETTER_AUTH_URL=http://localhost:3000

# First admin, created by `bun run db:seed`. Remove the password from the file afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Uploaded images: DigitalOcean Spaces. Leave all four empty to keep files in the database (fine
# locally). Create a key under API -> Spaces Keys with access to this Space only.
DO_SPACES_KEY=
DO_SPACES_SECRET=
# The Space's name and region, e.g. yb-media and sgp1.
DO_SPACES_BUCKET=
DO_SPACES_REGION=
# Optional: a folder inside the Space, so staging and production can share one (default "media").
DO_SPACES_FOLDER=
# Optional: only for a non-standard endpoint. Defaults to https://<region>.digitaloceanspaces.com.
DO_SPACES_ENDPOINT=
